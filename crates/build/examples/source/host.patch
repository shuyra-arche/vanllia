diff --git a/tools/shuyra-image/src/managed.rs b/tools/shuyra-image/src/managed.rs
new file mode 100644
index 00000000..125a74e9
--- /dev/null
+++ b/tools/shuyra-image/src/managed.rs
@@ -0,0 +1,34 @@
+//! The existing Integration CLI's explicit-root interface for Vanllia.
+use std::collections::BTreeMap;
+use std::path::PathBuf;
+
+pub fn run(args: &[String]) -> Option<Result<PathBuf, String>> {
+    let command = args.first()?.as_str();
+    if command != "check" && command != "build" { return None; }
+    Some((|| {
+        let mut options = BTreeMap::new();
+        let mut values = args[1..].iter();
+        while let Some(key) = values.next() {
+            if !["--root", "--work", "--out", "--deployment"].contains(&key.as_str()) {
+                return Err(format!("unknown argument {key}"));
+            }
+            let value = values.next().ok_or_else(|| format!("{key} needs a value"))?;
+            options.insert(key.as_str(), value.as_str());
+        }
+        let root = PathBuf::from(*options.get("--root").ok_or("--root required")?);
+        let scenario = options.get("--deployment").copied().unwrap_or("product");
+        let deployment = unit::Deployment::find(composition::DEPLOYMENTS, scenario)
+            .ok_or_else(|| format!("unknown deployment {scenario}"))?;
+        let (declarations, builds) = image::collect(&[image::Provider {
+            root: &root, declarations: composition::PROGRAMS, builds: composition::IMAGE_BUILDS,
+        }], "riscv64gc-unknown-none-elf")?;
+        if command == "check" {
+            println!("images: {:?}", image::image_inventory(&declarations, deployment, &builds)?);
+            println!("startup: {:?}", image::startup_order(&declarations, deployment)?);
+            return Ok(root);
+        }
+        let work = PathBuf::from(*options.get("--work").ok_or("--work required")?);
+        let output = PathBuf::from(*options.get("--out").ok_or("--out required")?);
+        image::build_with(&root, &work, &output, &declarations, deployment, &builds)
+    })())
+}
